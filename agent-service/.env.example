# Bearer token The Wringer must send on POST /run. Leave empty for open local dev.
WRINGER_AGENT_TOKEN=

# Hermes (live web/X research) -> xAI Agent Tools API
XAI_API_KEY=
# Optional override; defaults to https://api.x.ai/v1
XAI_BASE_URL=
HERMES_MODEL=grok-4.3
# Cap server-side tool calls per Hermes run to bound cost (default 6)
HERMES_MAX_TOOL_CALLS=6

# OpenClaw (reasoning/engineering doer with tool calling).
# Prefer OpenRouter (one key serves gpt-5.3-codex). If only OPENAI_API_KEY is
# set it will be used directly instead (requires OpenAI completion quota).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENCLAW_MODEL=openai/gpt-5.3-codex

# Tuning
PORT=8080
AGENT_TIMEOUT_S=180
AGENT_MAX_TOKENS=1500
